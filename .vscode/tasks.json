{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Start Android Emulator",
      "type": "shell",
      "command": "flutter emulators --launch pixel_7_api_35 || emulator -avd pixel_7_api_35",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Flutter: Pub Get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": ["$dart-analyze"],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Flutter: Test",
      "type": "shell",
      "command": "flutter test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Flutter: Gen L10n",
      "type": "shell",
      "command": "flutter gen-l10n",
      "problemMatcher": []
    }
  ]
}
